# AgentShield Environment Configuration Template
# Copy this file to .env and configure local or production settings

# Server Settings
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development

# Security Guardrails Policy
INJECTION_RISK_THRESHOLD=0.70
ENABLE_PII_REDACTION=true
ENABLE_TOOL_AUTHORIZATION=true
ENABLE_OUTPUT_VALIDATION=true

# Request Limits
MAX_TEXT_LENGTH=50000

# Authentication & Identity Settings
REQUIRE_API_KEY=false
APPROVAL_SECRET=change-this-to-a-secure-random-secret-in-production
APPROVAL_EXPIRY_SECONDS=900

# Red-Team Benchmark Thresholds
BENCHMARK_STRICT_MODE=true
MAX_ALLOWED_FALSE_POSITIVE_RATE=0.02
MAX_ALLOWED_ATTACK_SUCCESS_RATE=0.05
